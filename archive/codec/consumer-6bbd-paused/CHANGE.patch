+static void a1599_c0_ack_barrier(void *context)
+{
+	(void)context;
+	/* Order the finished record reads/copy before returning ownership of its
+	 * ring slots. This is not a hardware DMA-completion predicate. */
+	mb();
+}
+
+static const struct a1599_init_mmio_ops a1599_c0_ack_ops = {
+	.read32 = a1599_mmio_read32,
+	.write32 = a1599_mmio_write32,
+	.read_barrier = a1599_mmio_read_barrier,
+	.publish_barrier = a1599_c0_ack_barrier,
+};
+
+/* A separately approved terminal observation. It cannot reset decode_once's
+ * gate. Its result never implies output/command/reference memory can be reused. */
+static ssize_t c0_consumer_once_store(struct device *dev,
+				     struct device_attribute *attr,
+				     const char *buf, size_t count)
+{
+	int ret;
+
+	(void)attr;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!allow_c0_consumer_observation || !allow_output_export)
+		return -EACCES;
+	if (!READ_ONCE(a1599_first_ready_live) ||
+	    dev != READ_ONCE(a1599_live_device) || !a1599_memory ||
+	    !atomic_read(&a1599_decode_consumed))
+		return -EAGAIN;
+	mutex_lock(&a1599_ring_lock);
+	ret = a1599_c0_ack_once(&a1599_c0_ack_ops, &a1599_live_window,
+		&a1599_ack_c0, allow_c0_consumer_observation,
+		smp_load_acquire(&a1599_decode_output_snapshot_ready),
+		a1599_memory->hardware_started && a1599_memory->decode_lifetime.started,
+		&a1599_ack_state);
+	dev_warn(dev, "C0_CONSUMER_ONCE ret=%d attempted=%d write_issued=%d verified=%d offset=0x2fe8 value=3 after_valid_count=%u after_h2m=%u/%u after_m2h=%u/%u second_decode_allowed=0 dma_reuse_allowed=0 resources_pinned=%d retry=0\n",
+		 ret, a1599_ack_state.attempted, a1599_ack_state.write_issued,
+		 a1599_ack_state.verified, a1599_ack_state.after_valid_count,
+		 a1599_ack_state.after[2],
+		 a1599_ack_state.after[3], a1599_ack_state.after[4],
+		 a1599_ack_state.after[5], a1599_memory->hardware_started &&
+		 a1599_memory->decode_lifetime.started);
+	mutex_unlock(&a1599_ring_lock);
+	if (ret)
+		return ret;
+	return count;
+}
