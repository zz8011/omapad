+// 每个后端的判定结果：0 未判定，1 直接导入，-1 使用 blit（放在类外以保持 ABI）
+static std::unordered_map<const Aquamarine::CDRMBackend*, int> directImportStates;
+
+bool Aquamarine::CDRMBackend::mgpuDirectImport() {
+    if (!primary)
+        return false;
+    int& directImportState = directImportStates[this];
+    if (directImportState == 0) {
+        if (rendererState.renderer || (initMgpu() && rendererState.renderer && rendererState.allocator))
+            directImportState = -1;
+        else {
+            directImportState = 1;
+            backend->log(AQ_LOG_WARNING, std::format("drm: {} has no renderer, importing primary GPU linear buffers directly", gpu->path));
+        }
+    }
+    return directImportState == 1;
+}
