#!/bin/sh
# D2089 输入限流看门狗（仅 J85M / iPad mini 3）
#
# 背景：Linux 侧没有 Tristar CBTL1610 驱动，D2089 把 USB 口当成"未识别充电器"，
# 输入限流停在 iOS/DFU 遗留的 0x02（约 100 mA）。整机耗电 1.3 A 而输入只有 0.1 A
# → 电池净放电约 1.3 A，只能撑两小时左右。
#
# setup-gadget 启动时把 0x4C0 抬上去，这里周期性补写，防止 VBUS 重连把它复位
# （Pro 的 D2355 / 0x44e 就有这个复位行为）。盲写而不做读-比较-写，是为了不依赖
# dmesg 环形缓冲；写同一个值硬件无动作，安全。
#
# 2026-10-15 实测（I2C0 地址 0x3c，16 位大端寄存器寻址；电流为电量计 0x14 读数）：
#   0x4C0=0x02 → 电池 -1530 mA    iOS/DFU 遗留默认，等同"未识别充电器"
#   0x4C0=0x3f → 电池  -601 mA    低 6 位满档仍不够供整机
#   0x4C0=0x7f → 电池  +206 mA    ★ 转正
#   0x4C0=0xbf → 电池  +654~750 mA ★ 选用值
#   0x4C0=0xff → 电池  +577 mA
# 该寄存器有锁存/迟滞特性：值调低不会立刻生效。
#
# 目标值可运行时改（十六进制）：
#   echo 7f > /run/d2089-limit      # 弱电源用 0x7f（刚转正）

CMD=/sys/kernel/i2cprobe/cmd
LIMFILE=/run/d2089-limit

[ -e "$CMD" ] || exit 0

while true; do
    LIM=$(cat "$LIMFILE" 2>/dev/null)
    [ -n "$LIM" ] || LIM=bf
    echo "raw 0 0x3c 04 c0 $LIM" > "$CMD" 2>/dev/null
    sleep 30
done
