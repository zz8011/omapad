#!/bin/busybox sh
# A1599 gadget：acm.usb0 + acm.usb1（两个 root shell）+ ffs.gud（GUD 显示，gudd 提供）。
# GUD 部分任何一步失败，退回仅 2×ACM（原 1d6b:0104），保证维护口可用。
set -u
cfg=/sys/kernel/config/usb_gadget/a1599
ffs=/dev/ffs-gud
log() {
    printf '[A1599-gadget] %s\n' "$*" >>/dev/console
    printf '[A1599-gadget] %s\n' "$*" >>/run/setup-gadget.log
}
# 第一个 compatible 就是板名（m1n1 也用它挑 DTB），后面跟着 SoC / 平台。
# 取值实例：apple,j85m / apple,j86 / apple,j207
first_compat() { tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | head -1; }

set -- /sys/class/udc/*
[ -e "$1" ] || { log "ERROR 无 UDC"; exit 1; }
udc=${1##*/}
log "udc=$udc"

mkdir -p $cfg/strings/0x409 $cfg/configs/c.1/strings/0x409 || { log "ERROR 创建 gadget"; exit 1; }
echo 0x0200 > $cfg/bcdUSB
echo 0x0100 > $cfg/bcdDevice
echo Linux > $cfg/strings/0x409/manufacturer
echo "Local serial + display" > $cfg/configs/c.1/strings/0x409/configuration
echo 120 > $cfg/configs/c.1/MaxPower
for fn in acm.usb0 acm.usb1; do
    mkdir $cfg/functions/$fn && ln -s $cfg/functions/$fn $cfg/configs/c.1/$fn || { log "ERROR $fn"; exit 1; }
done

plain_acm() {
    log "GUD 不可用（$1），仅启用 2×ACM"
    rm -f $cfg/configs/c.1/ffs.gud
    echo 0x1d6b > $cfg/idVendor; echo 0x0104 > $cfg/idProduct
    echo "A1599 Local USB Services" > $cfg/strings/0x409/product
    echo $udc > $cfg/UDC && log "bind ok (2xACM)"
    /sbin/usb-linkwatch </dev/null >/dev/null 2>&1 &
    exit 0
}

grep -q '^usb_f_fs ' /proc/modules || insmod /lib/a1599/usb_f_fs.ko 2>>/run/setup-gadget.log || plain_acm "insmod usb_f_fs"
mkdir $cfg/functions/ffs.gud || plain_acm "mkdir ffs.gud"
mkdir -p $ffs && mount -t functionfs gud $ffs || plain_acm "mount functionfs"
echo 8 > /proc/sys/kernel/printk
/sbin/gudd-supervisor </dev/null >/dev/null 2>&1 &
/sbin/gudd-watchdog </dev/null >/dev/null 2>&1 &
i=0
while [ ! -e $ffs/ep1 ] && [ $i -lt 20 ]; do sleep 0.2; i=$((i + 1)); done
[ -e $ffs/ep1 ] || plain_acm "gudd 未就绪"
echo 0x1d50 > $cfg/idVendor; echo 0x614d > $cfg/idProduct
case "$(first_compat)" in
    apple,j207) name="iPad Pro 10.5 GUD Display" ;;
    # 两台 mini 的 EDID 目前写死一样（见 gud/edid.inc），USB 产品串是宿主侧唯一
    # 能区分它们的字段，所以这里分开写。
    apple,j86)  name="iPad mini 2 GUD Display" ;;
    *) name="A1599 GUD Display" ;;
esac
echo "$name" > $cfg/strings/0x409/product
ln -s $cfg/functions/ffs.gud $cfg/configs/c.1/ffs.gud || plain_acm "link ffs.gud"
if echo $udc > $cfg/UDC; then
    log "bind ok (2xACM + GUD)"
    /sbin/usb-linkwatch </dev/null >/dev/null 2>&1 &
else
    echo "" > $cfg/UDC 2>/dev/null
    plain_acm "bind"
fi

# 充电配置：两台机器都缺 Tristar CBTL1610 驱动（I2C0 地址 0x1a），PMU 把 USB 口
# 当成"未识别充电器"而把输入限流锁在极小值，整机耗电大于输入 → 电池净放电。
# 这里绕过缺失的识别环节，直接改写各自的输入限流寄存器。
# 任何一步失败都只记日志，不影响副屏功能。
setup_charging() {
    [ -e /proc/device-tree/compatible ] || return 0
    case "$(first_compat)" in
        apple,j207) setup_charging_d2355 ;;
        # D2089 已实测的两台：mini 3 Wi-Fi = apple,j85m，mini 2 Cellular = apple,j86。
        # 其余不猜 —— 同一颗 PMU 在其他 A7 设备上大概率一样，但没验证过，所以不按
        # apple,s5l8960x 泛匹配。mini 3 Cellular（apple,j86m）就是没机器可试的那个；
        # 它的 DT 与 mini 2 完全相同，将来有机器再加一个分支即可。
        apple,j85m|apple,j86) setup_charging_d2089 ;;
        *) return 0 ;;
    esac
}

# --- iPad Pro 10.5 (J207) / Dialog D2355：I2C0 0x75，输入限流 0x44e 单位 10 mA ---
setup_charging_d2355() {
    grep -q '^d2355_probe ' /proc/modules && return 0
    [ -e /lib/a1599/d2355-probe.ko ] || { log "charging: 无 d2355-probe.ko"; return 0; }
    insmod /lib/a1599/d2355-probe.ko 2>>/run/setup-gadget.log || {
        log "charging: insmod 失败"; return 0; }
    i=0
    while [ ! -e /sys/kernel/d2355/rw ] && [ $i -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
    [ -e /sys/kernel/d2355/rw ] || { log "charging: sysfs 未出现"; return 0; }
    # 1000 mA：实测在 USB 2.0 根端口上稳定。弱电源可改成 0x32 (500 mA)。
    { echo "w 0x4a6 0x01"   > /sys/kernel/d2355/rw; } 2>>/run/setup-gadget.log
    { echo "w 0xb10 0x1d"   > /sys/kernel/d2355/rw; } 2>>/run/setup-gadget.log
    sleep 0.2
    { echo "w 0x49a 0x5f"   > /sys/kernel/d2355/rw; } 2>>/run/setup-gadget.log
    sleep 0.2
    { echo "w 0xb10 0x00"   > /sys/kernel/d2355/rw; } 2>>/run/setup-gadget.log
    sleep 0.2
    { echo "w 0x44e 0x64"   > /sys/kernel/d2355/rw; } 2>>/run/setup-gadget.log
    sleep 0.4
    log "charging: $(dmesg | grep -E 'd2355: (read|write) 0x044e' | tail -1 | sed 's/.*d2355: //')"
    # VBUS 重连会把 0x44e 复位成 80 mA，起后台看门狗持续补回
    if [ -x /sbin/d2355-watchdog ]; then
        setsid /sbin/d2355-watchdog >/dev/null 2>&1 </dev/null &
        log "charging: 看门狗已启动"
    fi
}

# --- iPad mini（J85M / J86）/ Dialog D2089：I2C0 0x3c，输入限流 0x4C0（8 位，高 4 位是扩展位）---
# 2026-10-15 实测电量计电流：0x02 → -1530 mA（默认）  0x3f → -601 mA（仍不够）
#                            0x7f →  +206 mA（刚转正） 0xbf → +654~750 mA（选用）
setup_charging_d2089() {
    grep -q '^i2c_probe ' /proc/modules || {
        [ -e /lib/a1599/i2c-probe.ko ] || { log "charging: 无 i2c-probe.ko"; return 0; }
        insmod /lib/a1599/i2c-probe.ko 2>>/run/setup-gadget.log || {
            log "charging: insmod i2c-probe 失败"; return 0; }
    }
    i=0
    while [ ! -e /sys/kernel/i2cprobe/cmd ] && [ $i -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
    [ -e /sys/kernel/i2cprobe/cmd ] || { log "charging: i2cprobe sysfs 未出现"; return 0; }
    # 0xbf：实测在自供电 hub 口上净充电约 +0.65~0.75 A。弱电源可下调到 0x7f。
    { echo "raw 0 0x3c 04 c0 bf" > /sys/kernel/i2cprobe/cmd; } 2>>/run/setup-gadget.log
    sleep 0.4
    { echo "rawr 0 0x3c 04 c0 :1" > /sys/kernel/i2cprobe/cmd; } 2>>/run/setup-gadget.log
    log "charging: 0x4C0 回读 $(cat /sys/kernel/i2cprobe/out 2>/dev/null | grep read | tail -1)"
    # 与 D2355 同理：VBUS 重连可能把限流复位，起后台看门狗持续补回
    if [ -x /sbin/d2089-watchdog ]; then
        setsid /sbin/d2089-watchdog >/dev/null 2>&1 </dev/null &
        log "charging: D2089 看门狗已启动"
    fi
}

setup_charging
