+/*
+ * A1599/J207 GUD 副屏：GUD 的流量几乎全是 bulk OUT，默认 539 字的 RX FIFO（约 4 个包）
+ * 会把 HS 吞吐限制在每微帧一次 FIFO（实测约 18 MB/s）。dwc2.apple_rx_fifo=N（字）
+ * 加大 RX FIFO；发送 FIFO 改为前两个 128 字（ACM bulk IN 512 B）、其余 16 字。0 = 原行为。
+ */
+static unsigned int apple_rx_fifo;
+module_param(apple_rx_fifo, uint, 0444);
+MODULE_PARM_DESC(apple_rx_fifo, "Apple dwc2: RX FIFO size in words (0 = default)");
+
+/*
+ * iOS 12.5.8 AppleSynopsysOTGDevice 的核心初始化（REA/Ghidra 反编译，FUN_fffffff008366700）：
+ * GAHBCFG = ahb-burst(默认 10) | 0x21 → HBSTLEN=5（INCR8）+ DMAEn，缓冲区 DMA（不设 DCFG.DescDMA），
+ * GRXFSIZ = 0x21b。Linux 默认为 HBSTLEN_INCR 且在硬件支持时启用描述符 DMA。
+ * dwc2.apple_ahb_burst=N：HBSTLEN 字段值（-1 = 保持默认）；
+ * dwc2.apple_desc_dma=0/1：关闭/保留描述符 DMA（-1 = 保持默认）。
+ */
+static int apple_ahb_burst = -1;
+module_param(apple_ahb_burst, int, 0444);
+MODULE_PARM_DESC(apple_ahb_burst, "Apple dwc2: GAHBCFG HBSTLEN value (-1 = default; iOS uses 5 = INCR8)");
+static int apple_desc_dma = -1;
+module_param(apple_desc_dma, int, 0444);
+MODULE_PARM_DESC(apple_desc_dma, "Apple dwc2: descriptor DMA in gadget mode (-1 = default; iOS uses buffer DMA = 0)");
+
